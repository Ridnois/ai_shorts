# Copy to .env (gitignored, chmod 600) and fill in. Never commit real values: the repo is public.
# YouTube (OAuth Desktop client "Redtail Uploader", Google Cloud project redtail-upload); the refresh token is written by
# `python3 System/scripts/youtube_auth.py` (pick REDTAIL at consent; it expires weekly while the app is in Testing)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Replicate: voice (inworld/realtime-tts-2), word timings, opt-in stills and clips (replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=
# Stock footage, free keys: stock_videos.py --source pexels | pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
# /instagram-research and /video-content-analyzer
APIFY_TOKEN=
GEMINI_API_KEY=
