filters:
  and:
    - file.inFolder("Pipeline/Ideas")
properties:
  file.name:
    displayName: Idea
  note.status:
    displayName: Status
  note.series:
    displayName: Series
  note.score:
    displayName: Score
  note.publish:
    displayName: Publish
  note.video:
    displayName: Video
views:
  - type: table
    name: Queue
    filters:
      or:
        - note.status == "idea"
        - note.status == "next"
    sort:
      - property: note.score
        direction: DESC
    order:
      - file.name
      - note.status
      - note.series
      - note.score
  - type: table
    name: In the works
    filters:
      or:
        - note.status == "making"
        - note.status == "review"
    order:
      - file.name
      - note.status
      - note.series
      - note.video
  - type: table
    name: All
    groupBy:
      property: note.status
      direction: ASC
    order:
      - file.name
      - note.status
      - note.series
      - note.score
      - note.publish
      - note.video
