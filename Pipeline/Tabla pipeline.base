filters:
  and:
    - file.inFolder("Pipeline/Ideas")
properties:
  file.name:
    displayName: Idea
  note.estado:
    displayName: Estado
  note.formato:
    displayName: Formato
  note.publicar:
    displayName: Publicar
  note.presupuesto_estimado_usd:
    displayName: Presup. estimado $
  note.presupuesto_aprobado_usd:
    displayName: Presup. aprobado $
  note.costo_real_usd:
    displayName: Costo real $
  note.video:
    displayName: Video
  note.error:
    displayName: Error
views:
  - type: table
    name: Esta semana
    filters:
      and:
        - note.publicar >= today() - "1 day"
        - note.publicar <= today() + "7 days"
    sort:
      - property: note.publicar
        direction: ASC
    order:
      - file.name
      - note.estado
      - note.publicar
      - note.formato
      - note.presupuesto_estimado_usd
      - note.presupuesto_aprobado_usd
      - note.costo_real_usd
      - note.error
  - type: table
    name: Todas
    groupBy:
      property: note.estado
      direction: ASC
    order:
      - file.name
      - note.estado
      - note.formato
      - note.presupuesto_estimado_usd
      - note.presupuesto_aprobado_usd
      - note.costo_real_usd
      - note.video
      - note.error
  - type: table
    name: En cola o trabajando
    filters:
      or:
        - note.estado == "construir-guion"
        - note.estado == "construyendo-guion"
        - note.estado == "generar-assets"
        - note.estado == "generando-assets"
    order:
      - file.name
      - note.estado
      - note.presupuesto_aprobado_usd
  - type: table
    name: Esperan tu decisión
    filters:
      or:
        - note.estado == "guion-listo"
        - note.estado == "ilustraciones-listas"
        - note.estado == "error"
    order:
      - file.name
      - note.estado
      - note.presupuesto_estimado_usd
      - note.presupuesto_aprobado_usd
      - note.error
